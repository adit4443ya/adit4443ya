<svg xmlns="http://www.w3.org/2000/svg" width="900" height="380" viewBox="0 0 900 380" role="img" aria-label="Benchmarking a love story">
  <defs>
    <style>
      .title { fill: #c9d1d9; font: 700 18px SFMono-Regular, Menlo, Consolas, monospace; }
      .label { fill: #c9d1d9; font: 14px SFMono-Regular, Menlo, Consolas, monospace; }
      .muted { fill: #8b949e; font: 12px SFMono-Regular, Menlo, Consolas, monospace; }
    </style>
  </defs>
  <rect width="900" height="380" rx="12" fill="#0d1117"/>
  <text x="450" y="36" text-anchor="middle" class="title">Benchmarking: a love story</text>

  <text x="60" y="100" class="label">run 1 · laptop on battery · 14 tabs open</text>
  <rect x="60" y="110" width="544" height="30" rx="5" fill="#d29922"/>
  <text x="618" y="131" fill="#d29922">3.20x  (screenshotted)</text>

  <text x="60" y="182" class="label">run 2 · same machine · closed the tabs</text>
  <rect x="60" y="192" width="156" height="30" rx="5" fill="#8b949e"/>
  <text x="244" y="213" fill="#8b949e">0.92x</text>

  <text x="60" y="264" class="label">pinned cores · perf governor · n=30 · variance reported</text>
  <rect x="60" y="274" width="177" height="30" rx="5" fill="#3fb950"/>
  <text x="251" y="295" fill="#3fb950">1.04x  &lt;- the real number</text>

  <line x1="230" y1="76" x2="230" y2="330" stroke="#8b949e" stroke-dasharray="4 4"/>
  <text x="230" y="70" text-anchor="middle" class="muted">baseline 1.0x</text>
  <text x="450" y="362" text-anchor="middle" class="muted">the honest number is always the least exciting one.</text>
</svg>
